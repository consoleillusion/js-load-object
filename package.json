{
  "name": "load-object",
  "version": "2.0.0",
  "description": "Load data files (JSON, YAML, TOML, XML, HTML, Markdown, CBOR, Dhall) from local paths or URLs into JavaScript values.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "load-object": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mithrayls/js-load-object.git"
  },
  "keywords": [
    "json",
    "yaml",
    "toml",
    "cbor",
    "dhall",
    "xml",
    "html",
    "markdown",
    "load",
    "parse",
    "bun",
    "typescript"
  ],
  "author": "Raymond Smith",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@ipld/dag-cbor": "^9.2.2",
    "cmd-ts": "^0.14.0",
    "dhall-wasm": "github:consoleillusion/dhall-wasm#2e0e880a10feae9e9fd28ff57f33da97804b4c77",
    "fast-xml-parser": "^4.5.1",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.2",
    "parse5": "^7.2.1",
    "ramda": "^0.30.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/ramda": "^0.30.2",
    "typescript": "^5.7.2"
  }
}
